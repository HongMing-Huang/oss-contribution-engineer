[{"sha":"40abfa72f8bf110ef6232d37de8a3cab0dc13351","node_id":"C_kwDOASN_zNoAKDQwYWJmYTcyZjhiZjExMGVmNjIzMmQzN2RlOGEzY2FiMGRjMTMzNTE","url":"https://api.github.com/repos/pallets/click/git/commits/40abfa72f8bf110ef6232d37de8a3cab0dc13351","html_url":"https://github.com/pallets/click/commit/40abfa72f8bf110ef6232d37de8a3cab0dc13351","author":{"name":"okxint","email":"cashmein.eth@gmail.com","date":"2026-09-16T13:47:05Z"},"committer":{"name":"okxint","email":"cashmein.eth@gmail.com","date":"2026-09-16T13:47:05Z"},"tree":{"sha":"149e5069223519dd6ebd469ac8435b6b91e049a5","url":"https://api.github.com/repos/pallets/click/git/trees/149e5069223519dd6ebd469ac8435b6b91e049a5"},"message":"fix(edit): resolve editor command via shutil.which before launching\n\nedit_files() passed the bare editor name directly to subprocess.Popen\nwithout resolving it to a full path first.  On Windows 11 some commands\n(e.g. the Store-app notepad redirect) only launch correctly when invoked\nvia their absolute path, causing WinError 87 or WinError 14001.\n\nThe pager code already does this correctly via _resolve_pager_command.\nApply the same pattern in edit_files(): call shutil.which() on the first\ntoken of the editor command, and substitute the result when found.  When\nshutil.which() returns None (command not on PATH), the original token is\nkept as-is, preserving the existing behaviour.\n\nFixes #3840","parents":[{"sha":"6aabf099bfdd4c1e75fe8d0e0d4241372b988ab1","url":"https://api.github.com/repos/pallets/click/git/commits/6aabf099bfdd4c1e75fe8d0e0d4241372b988ab1","html_url":"https://github.com/pallets/click/commit/6aabf099bfdd4c1e75fe8d0e0d4241372b988ab1"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"url":"https://api.github.com/repos/pallets/click/issues/comments/5700784125","html_url":"https://github.com/pallets/click/pull/3874#issuecomment-5700784125","issue_url":"https://api.github.com/repos/pallets/click/